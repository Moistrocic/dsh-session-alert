# 依赖与构建产物
node_modules/
*.log
.pnpm-store/

# 本地对照用的残留目录（先前尝试的源码副本与旧配置）。
# 它是本机工作残留，不是本项目的产物，也不参与构建，故不入库。
legacy/

# 提交信息用的临时文件（PowerShell 无 heredoc，需落文件再传给 git -F）
.commit-msg*

# 编译产物：启动器由源码在安装时编译（scripts/build-launcher.ps1），不入库。
# 仓库里躺着一个可能过期的二进制比没有它更糟——用户会以为它是最新的。
# 源码是唯一事实来源：lib/launcher/*.cs。
# 注意写法：忽略 bin/ 下的**内容**但保留目录本身（.gitkeep），
# 否则一次干净检出后 bin/ 不存在，编译脚本还得自己建目录。
bin/*
!bin/.gitkeep
*.exe
*.pdb

# 编辑器与系统垃圾
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
